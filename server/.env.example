# Copy to .env and fill in. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://rk:change-me@localhost:5432/rk_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
# Comma separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
# Set true when running behind Hostinger's / nginx reverse proxy
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
LOG_LEVEL=info
# Used once by `npm run seed` to create the platform super admin
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# --- Phase 7 (not used yet; backend only, never exposed to the frontend) ---
AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com
AISENSY_WA_NUMBER=
