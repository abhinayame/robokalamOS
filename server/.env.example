# Copy to .env and fill in. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
# MySQL 8 / MariaDB 10.6+ (Hostinger: hPanel → Databases → MySQL Databases shows these)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dbuser
DB_PASSWORD=change-me
DB_NAME=dbname
# (alternative to the five lines above: DATABASE_URL=mysql://user:password@host:3306/db, password URL-encoded)
# true only for a remote database that requires TLS
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
# Comma separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
# Set true when running behind Hostinger's / nginx reverse proxy
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
LOG_LEVEL=info
# Used once by `npm run seed` to create the platform super admin
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# --- Phase 7: WhatsApp via AiSensy (backend only; never exposed to the frontend) ---
# Leave AISENSY_API_KEY empty and the app will not send anything (the Communication screen says so).
AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com
AISENSY_WA_NUMBER=
# Long random value (16+ chars). Delivery webhooks are accepted only at /api/webhooks/aisensy/<this value>.
AISENSY_WEBHOOK_SECRET=
WHATSAPP_RATE_PER_SECOND=5
COMMS_WORKER=true
# Largest upload in MB (files are stored in the database; 1-20)
UPLOAD_MAX_MB=5
AISENSY_CAMPAIGN_PATH=
# Cleanup job every 6h (expired sessions, orphan uploads, old webhook logs). Never touches learner data.
MAINTENANCE=true
# Encrypts files made by `npm run backup` (12+ chars). Keep it OUT of git and store it separately from the backups.
BACKUP_PASSPHRASE=

# --- Phase 10: online fee payments via Razorpay Payment Links (backend only; never exposed to the browser) ---
# Leave empty to use manual payments only. Use test-mode keys until you have made one real test payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
# You choose this; put the same value in Razorpay -> Settings -> Webhooks (URL: https://your-domain/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=
# Automatic reminders (fee due/overdue, class, absence); runs inside the WhatsApp worker
REMINDERS=true
